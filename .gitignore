# Binaries (anchored to repo root so cmd/tera-agent/ source is NOT ignored)
/bin/
/dist/
/tera-agent
/tera-agent-linux
# Cualquier ejecutable Windows (agente, backups, pdftoppm bundle). El código
# fuente es .go, así que *.exe nunca es fuente.
*.exe

# Scratchpad / temporales de desarrollo
/scratchpad/

# Recursos de Windows (icono + datos de version) de los .exe: los genera
# tools/winres en cada build de release con la version de ese release.
/cmd/tera-agent/*.syso

# Staging del instalador: lo regenera scripts/build-release.ps1 en cada build
# (binarios + bundle de poppler, ~40 MB). El .iss sí se versiona.
/installer/staging/

# Local config with secrets (Token). Never commit.
config.json
config.yaml

# Go
*.test
*.out
coverage.*

# Editors / OS
.DS_Store
.idea/
.vscode/
